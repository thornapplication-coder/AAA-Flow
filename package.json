{
  "name": "project-control-center",
  "private": true,
  "version": "1.10.0",
  "description": "Project Control Center — Projektsteuerung der Aviation Academy Austria",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "db:check": "./scripts/db-check.sh",
    "check:sandbox": "node scripts/check-sandbox.mjs",
    "check:app": "node scripts/check-app.mjs",
    "check:logic": "node scripts/check-logic.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "verify": "npm run typecheck && npm run check:logic && npm run check:sandbox && npm run check:layout && npm run check:app",
    "verify:db": "npm run verify && npm run db:check"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.114.0",
    "i18next": "^26.4.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-i18next": "^17.0.13",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0"
  }
}
